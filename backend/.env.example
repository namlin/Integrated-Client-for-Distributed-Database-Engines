# Copy this file to .env and fill in your values
# The backend reads DB credentials from the API (POST /api/connections) at runtime,
# not from environment variables — this file is for reference only.

# Optional: override the WAL DB path
# WAL_DB_PATH=./database/wal.db

# Example connection details (enter via the UI or API):
# PostgreSQL: host=localhost port=5432 user=postgres password=secret db=mydb
# MongoDB:    host=localhost port=27017 user=admin   password=secret db=mydb
# MySQL:      host=localhost port=3306  user=root    password=secret db=mydb
# Redis:      host=localhost port=6379  password=     db=0
